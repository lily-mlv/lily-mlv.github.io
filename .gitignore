/* BOUTONS CLIQUABLES 

 .button{
    background: #ffffff;
    color: #000;
    text-decoration: none;
    border: 2px solid #000;
    padding: 4px 10px;
    margin: auto;
    border-radius: 10px;
    transition: 0.5s background;
}

.button:hover {
    background: #e33587;
    transition: background 0.5s;
}


/* TEXTES PROJETS
p{
    text-align: left;
    font-family: "Neco-Regular", sans-serif;
    font-optical-sizing: auto;
    font-size: 20px;
    font-weight: 250;
    font-style: normal;
    font-variation-settings:
    "wdth" 100;
    margin: 26px;
    padding: 26px 12px 12px 12px;

}

@font-face {
  font-family: 'Neco-Regular';
  src: url('../fonts/Neco-Regular.woff2') format('woff2'),
       url('../fonts/Neco-Regular.woff') format('woff'),
       url('../fonts/Neco-Regular.ttf') format('truetype');
  font-weight: 400;
  font-display: swap;
  font-style: normal;
}


.grid-txt p {
  margin-left: 26px;
  margin: 0%;
  padding: 26px 12px 12px 0px;
  gap: 16px;
}

.grid-txt {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px;
    align-items: start;
}

.titre-projet {
    padding: 70px 16px 0px 16px;
    font-family: "Anybody", sans-serif;
    font-optical-sizing: auto;
    font-size: 90px;
    text-align: left;
}


.sous-titre-projet{
    margin: 0px 16px 16px 16px;
    padding: 0px 16px 16px 16px;
    font-family: "Anybody", sans-serif;
    font-optical-sizing: auto;
    font-weight: 400;
    font-size: 30px;
    text-align: left;
}

.infos-projet p {
    margin: 0 0 0px;
    padding: 0px 22px 16px 16px;
}

