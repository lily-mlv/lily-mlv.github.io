    margin-left: 26px;
    margin-right: 26px;
} */

/* IMAGES PROJETS

img{
    display:block;  
    max-width: 100%;
    height: auto;
    transition: 0.5s background;
}

.grid-img {
  display: grid;
  grid-template-columns: repeat(2,1fr);
  gap: 16px;
  width: 100%;
  margin: 0;
  box-sizing: border-box;
}

.grid-img img {
  width: 100%;
  aspect-ratio: 1 / 1; 
  object-fit: cover;
  display: block;
}




.footer {
    align-items: center;
    padding: 16px;
    background-color: #fff;
    border-top: 2px solid #000;
    font-family: "Anybody", sans-serif;
    font-size: 7px;
}

.about-links a {
  color: #000000;
  text-decoration: none;
  font-size: 14px;
  transition: color 0.5s ease;
}



{
    box-sizing: border-box;
}

img {
    display: block;
    max-width: 100%;
    height: auto;
}




/* En-tête : le titre reste centré dans la page 
.header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: clamp(4px, 1.5vw, 16px);
    position: sticky;
    top: 0;
    z-index: 10;
    height: clamp(64px, 9vw, 84px);
    padding-inline: clamp(8px, 2vw, 24px);
    background: #fff;
    border-bottom: 2px solid #e33587;
    font-family: "Anybody", sans-serif;
}

.header .logo {
    width: clamp(48px, 7vw, 72px);
    height: clamp(48px, 7vw, 72px);
    object-fit: contain;
    justify-self: start;
}

.header h1 {
    min-width: 0;
    margin: 0;
    text-align: center;
    font-size: clamp(18px, 2.5vw, 30px);
}

.header span {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    justify-self: end;
    gap: clamp(4px, 1vw, 10px);
    margin: 0;
    font-size: clamp(12px, 1.7vw, 20px);
}



/* Titres et textes : taille fluide entre petit et grand écran 
h1 {
    font-size: clamp(24px, 4vw, 48px);
}

h2 {
    margin: clamp(24px, 5vw, 70px) clamp(12px, 2vw, 16px) 0;
    font-size: clamp(20px, 2.5vw, 32px);
}

h3 {
    margin: clamp(40px, 8vw, 120px) clamp(12px, 2vw, 30px) 30px 16px;
    font-size: clamp(36px, 7vw, 70px);
}

p {
    margin: clamp(12px, 2vw, 26px);
    padding: clamp(12px, 2vw, 26px) clamp(8px, 1.5vw, 12px);
    font-size: clamp(16px, 1.5vw, 20px);
}


/* Les colonnes se replient automatiquement si l'écran est étroit 
.grid-txt {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: clamp(12px, 2vw, 24px);
}

.grid-img {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: clamp(8px, 2vw, 16px);
    margin: clamp(12px, 2vw, 26px);
}

.titre-projet {
    padding: clamp(32px, 7vw, 70px) clamp(12px, 2vw, 16px) 0;
    font-size: clamp(40px, 8vw, 90px);
}

.sous-titre-projet {
    font-size: clamp(18px, 2.5vw, 30px);
}

/* Petits écrans 
@media (max-width: 480px) {
    .header {
        padding-inline: 8px;
    }

    .header span {
        font-size: 12px;
    }

    .grid-img img {
        aspect-ratio: auto;
    }
}


/* Pages projets : conserver deux colonnes sur ordinateur 
.grid-txt {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(12px, 2vw, 24px);
}

.grid-img {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(8px, 2vw, 16px);
    margin: clamp(12px, 2vw, 26px);
}

/* Titre de projet : fluide, sans dépasser la taille d'origine 
.titre-projet {
    font-size: clamp(42px, 7vw, 90px);
    padding: clamp(32px, 7vw, 70px) 16px 0;
}

/* Sur mobile, passer les grilles en une colonne 
@media (max-width: 700px) {
    .grid-txt,
    .grid-img {
        grid-template-columns: 1fr;
    }

    .titre-projet {
        font-size: clamp(36px, 10vw, 56px);
        padding-top: 32px;
    }

    .sous-titre-projet {
        font-size: clamp(18px, 5vw, 26px);
    }
}
*/


<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
